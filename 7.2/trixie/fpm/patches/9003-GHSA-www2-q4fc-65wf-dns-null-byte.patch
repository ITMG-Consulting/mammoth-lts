+++ b/ext/standard/tests/network/ghsa-www2-q4fc-65wf.phpt
@@ -0,0 +1,43 @@
+--TEST--
+GHSA-www2-q4fc-65wf
+--DESCRIPTION--
+This is a ZPP test but *keep* this as it is security-sensitive!
+--FILE--
+<?php
+var_dump(dns_check_record("\0"));
+var_dump(dns_get_mx("\0", $out));
+var_dump(dns_get_record("\0"));
+var_dump(getprotobyname("\0"));
+var_dump(getservbyname("\0", "tcp"));
+var_dump(getservbyname("x", "tcp\0"));
+var_dump(getservbyport(0, "tcp\0"));
+var_dump(inet_pton("\0"));
+var_dump(ip2long("\0"));
+?>
+--EXPECTF--
+Warning: dns_check_record() expects parameter 1 to be a valid path, string given in %s on line %d
+NULL
+
+Warning: dns_get_mx() expects parameter 1 to be a valid path, string given in %s on line %d
+NULL
+
+Warning: dns_get_record() expects parameter 1 to be a valid path, string given in %s on line %d
+NULL
+
+Warning: getprotobyname() expects parameter 1 to be a valid path, string given in %s on line %d
+NULL
+
+Warning: getservbyname() expects parameter 1 to be a valid path, string given in %s on line %d
+NULL
+
+Warning: getservbyname() expects parameter 2 to be a valid path, string given in %s on line %d
+NULL
+
+Warning: getservbyport() expects parameter 2 to be a valid path, string given in %s on line %d
+NULL
+
+Warning: inet_pton() expects parameter 1 to be a valid path, string given in %s on line %d
+bool(false)
+
+Warning: ip2long() expects parameter 1 to be a valid path, string given in %s on line %d
+NULL
