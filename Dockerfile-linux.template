			if vid >= ("7.2" | version_id) then "libargon2-dev" else empty end,
			"libcurl4-openssl-dev",
			if vid < ("7.3" | version_id) then "libedit-dev" else "libreadline-dev" end,
			if vid >= ("7.2" | version_id) then "libsodium-dev" else empty end,
			"libsqlite3-dev",
			"libssl-dev",
			"libxml2-dev",
			"zlib1g-dev",
