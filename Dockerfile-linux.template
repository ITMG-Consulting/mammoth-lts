	[
		[ if is_alpine then
			# alpine packages
			"$PHPIZE_DEPS",
			if vid >= ("7.2" | version_id) then "argon2-dev" else empty end,
			"coreutils",
			"curl-dev",
			# https://www.php.net/manual/en/intro.iconv.php "it'd be a good idea to install the GNU libiconv library"
			if gnu_iconv then "gnu-libiconv-dev" else empty end,
			if vid >= ("7.2" | version_id) then "libsodium-dev" else empty end,
			"libxml2-dev",
