{{
	def version_id:
		# https://www.php.net/phpversion
		# $version_id = $major_version * 10000 + $minor_version * 100 + $release_version;
		sub("[a-zA-Z].*$"; "")
		| split(".")
		| (
			(.[0] // 0 | tonumber) * 10000
			+ (.[1] // 0 | tonumber) * 100
			+ (.[2] // 0 | tonumber)
		)
	;
	def is_alpine:
		env.from | startswith("alpine")
	;
	def rcVersion:
		env.version | rtrimstr("-rc")
	;
	def clean_apt:
		# "apt-get dist-clean" appeared in apt 2.7 (trixie)
		if env.from | contains("trixie") then
			"apt-get dist-clean"
		else "rm -rf /var/lib/apt/lists/*" end
	;
	def archived_debian:
		# suites only served by archive.debian.org (security included, as "<suite>/updates")
		IN(env.suite; "jessie", "stretch", "buster", "bullseye")
	;
	def expired_archive_key:
		# archived suites whose Debian archive signing key has expired: apt cannot authenticate them any more
		IN(env.suite; "jessie")
	;
	def gnupg1:
		# jessie ships GnuPG 1.4: no gpgconf, and no agent to kill either (as the Docker Hub image of that era)
		IN(env.suite; "jessie")
	;
	def old_gcc:
		# jessie ships gcc 4.9: no -Wincompatible-pointer-types (gcc 5) and no -std=c++17 (its ICU 52 predates the
		# C++17 headers of ICU 75 that the flag is there for)
		IN(env.suite; "jessie")
	;
	def gnu_iconv:
		# GNU libiconv instead of musl's iconv; alpine3.9 (7.1) has no gnu-libiconv package, like the Docker Hub image
		is_alpine and (env.suite | ltrimstr("alpine") | version_id) >= ("3.10" | version_id)
	;
	def gcc14:
		# gcc >= 14: alpine 3.21+, debian trixie+
		if is_alpine then
			(env.suite | ltrimstr("alpine") | version_id) >= ("3.21" | version_id)
		else IN(env.suite; "jessie", "stretch", "buster", "bullseye", "bookworm") | not end
	;
	def vid:
		.version | version_id
	;
	def system_pcre:
		# like deb.sury.org: the OS PCRE (maintained) instead of the copy bundled with an EOL php-src (frozen),
		# on the currently supported suites only; PCRE1 (PHP < 7.3) is gone from Debian trixie
		any(.currentSuites[]; . == env.suite)
		and (vid >= ("7.3" | version_id) or is_alpine or env.suite == "bookworm")
	;
	def pcre_dev:
		if vid >= ("7.3" | version_id) then
			if is_alpine then "pcre2-dev" else "libpcre2-dev" end
		else
			if is_alpine then "pcre-dev" else "libpcre3-dev" end
		end
	;
	def has_patches:
		# patches/<version>/series: backported security fixes (tools/import-sury-patches.sh) + local build fixes
		.patches // false
-}}
FROM {{ env.from }}

{{ if archived_debian then ( -}}
# {{ env.suite }} is EOL: its packages (security updates included) only remain on archive.debian.org
{{ if expired_archive_key then "# Debian never renews the signing key of an archived release: the " + env.suite + " keys expired (2020-04-25, 2022-11-19),\n# so apt cannot authenticate archive.debian.org any more. Package integrity rests on the checksums of the Release\n# file, and the PHP sources are verified by their own GPG signature and SHA-256 (below).\n" else "" end -}}
RUN set -eux; \
	sed -ri \
		-e 's!https?://(deb|security)\.debian\.org/!http://archive.debian.org/!' \
		-e '/-updates/d' \
		/etc/apt/sources.list; \
	echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99archive{{ if expired_archive_key then "; \\\n\techo 'APT::Get::AllowUnauthenticated \"true\";' >> /etc/apt/apt.conf.d/99archive" else "" end }}

{{ ) else "" end -}}
{{ if is_alpine then "" else ( -}}
# prevent Debian's PHP packages from being installed
# https://github.com/docker-library/php/pull/542
RUN set -eux; \
	{ \
		echo 'Package: php*'; \
		echo 'Pin: release *'; \
		echo 'Pin-Priority: -1'; \
	} > /etc/apt/preferences.d/no-debian-php

{{ ) end -}}
# dependencies required for running "phpize"
{{ if is_alpine then ( -}}
# these get automatically installed and removed by "docker-php-ext-*" (unless they're already installed)
{{ ) else ( -}}
# (see persistent deps below)
{{ ) end -}}
ENV PHPIZE_DEPS \
		autoconf \
		dpkg-dev {{ if is_alpine then "dpkg " else "" end }}\
		file \
		g++ \
		gcc \
		libc-dev \
		make \
		{{ if is_alpine then "pkgconf" else "pkg-config" end }} \
		re2c{{ if system_pcre then " \\\n# the installed PHP headers include the system pcre headers\n\t\t" + pcre_dev else "" end }}

# persistent / runtime deps
{{ if is_alpine then ( -}}
RUN apk add --no-cache \
		ca-certificates \
		curl \
		openssl \
		tar \
		xz

# ensure www-data user exists
RUN set -eux; \
# the www-data group ships with alpine-baselayout since Alpine 3.14
	grep -q '^www-data:' /etc/group || addgroup -g 82 -S www-data; \
	adduser -u 82 -D -S -G www-data www-data
# 82 is the standard uid/gid for "www-data" in Alpine
# https://git.alpinelinux.org/aports/tree/main/apache2/apache2.pre-install?h=3.14-stable
# https://git.alpinelinux.org/aports/tree/main/lighttpd/lighttpd.pre-install?h=3.14-stable
# https://git.alpinelinux.org/aports/tree/main/nginx/nginx.pre-install?h=3.14-stable
{{ ) else ( -}}
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
		$PHPIZE_DEPS \
		ca-certificates \
		curl \
		xz-utils \
	; \
	{{ clean_apt }}
{{ ) end -}}

ENV PHP_INI_DIR /usr/local/etc/php
RUN set -eux; \
	mkdir -p "$PHP_INI_DIR/conf.d"; \
# allow running as an arbitrary user (https://github.com/docker-library/php/issues/743)
	[ ! -d /var/www/html ]; \
	mkdir -p /var/www/html; \
	chown www-data:www-data /var/www/html; \
	chmod 1777 /var/www/html

{{ if env.variant == "apache" then ( -}}
ENV APACHE_CONFDIR /etc/apache2
ENV APACHE_ENVVARS $APACHE_CONFDIR/envvars

RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends apache2; \
	{{ clean_apt }}; \
	\
# generically convert lines like
#   export APACHE_RUN_USER=www-data
# into
#   : ${APACHE_RUN_USER:=www-data}
#   export APACHE_RUN_USER
# so that they can be overridden at runtime ("-e APACHE_RUN_USER=...")
	sed -ri 's/^export ([^=]+)=(.*)$/: ${\1:=\2}\nexport \1/' "$APACHE_ENVVARS"; \
	\
# setup directories and permissions
	. "$APACHE_ENVVARS"; \
	for dir in \
		"$APACHE_LOCK_DIR" \
		"$APACHE_RUN_DIR" \
		"$APACHE_LOG_DIR" \
# https://salsa.debian.org/apache-team/apache2/-/commit/b97ca8714890ead1ba6c095699dde752e8433205
		"$APACHE_RUN_DIR/socks" \
	; do \
		rm -rvf "$dir"; \
		mkdir -p "$dir"; \
		chown "$APACHE_RUN_USER:$APACHE_RUN_GROUP" "$dir"; \
# allow running as an arbitrary user (https://github.com/docker-library/php/issues/743)
		chmod 1777 "$dir"; \
	done; \
	\
# delete the "index.html" that installing Apache drops in here
	rm -rvf /var/www/html/*; \
	\
# logs should go to stdout / stderr
	ln -sfT /dev/stderr "$APACHE_LOG_DIR/error.log"; \
	ln -sfT /dev/stdout "$APACHE_LOG_DIR/access.log"; \
	ln -sfT /dev/stdout "$APACHE_LOG_DIR/other_vhosts_access.log"; \
	chown -R --no-dereference "$APACHE_RUN_USER:$APACHE_RUN_GROUP" "$APACHE_LOG_DIR"

# Apache + PHP requires preforking Apache for best results
RUN a2dismod mpm_event && a2enmod mpm_prefork

# PHP files should be handled by PHP, and should be preferred over any other file type
RUN { \
		echo '<FilesMatch \.php$>'; \
		echo '\tSetHandler application/x-httpd-php'; \
		echo '</FilesMatch>'; \
		echo; \
		echo 'DirectoryIndex disabled'; \
		echo 'DirectoryIndex index.php index.html'; \
		echo; \
		echo '<Directory /var/www/>'; \
		echo '\tOptions -Indexes'; \
		echo '\tAllowOverride All'; \
		echo '</Directory>'; \
	} | tee "$APACHE_CONFDIR/conf-available/docker-php.conf" \
	&& a2enconf docker-php

{{ ) else "" end -}}
# Apply stack smash protection to functions using local buffers and alloca()
# Make PHP's main executable position-independent (improves ASLR security mechanism, and has no performance impact on x86_64)
# Enable optimization (-O2)
# Enable linker optimization (this sorts the hash buckets to improve cache locality, and is non-default)
# https://github.com/docker-library/php/issues/272
# -D_LARGEFILE_SOURCE and -D_FILE_OFFSET_BITS=64 (https://www.php.net/manual/en/intro.filesystem.php)
{{ if vid < ("8.1" | version_id) then ( -}}
# PHP 7 predates gcc 14+ (C23 by default in gcc 15, incompatible-pointer-types as an error) and ICU 75+ (C++17 headers)
# same flags as deb.sury.org for these versions
{{ if gcc14 then ( -}}
# -fpermissive: gcc 14 makes implicit declarations / implicit int errors, which silently fails configure checks
# (getaddrinfo, pread/pwrite, ZEND_MM_ALIGNMENT, POSIX readdir_r...)
ENV PHP_CFLAGS="-fstack-protector-strong -fpic -fpie -O2 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -std=gnu99 -Wno-error=incompatible-pointer-types -fno-strict-aliasing -fpermissive"
{{ ) elif old_gcc then ( -}}
# gcc 4.9 has no -Wincompatible-pointer-types to demote (it came with gcc 5)
ENV PHP_CFLAGS="-fstack-protector-strong -fpic -fpie -O2 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -std=gnu99 -fno-strict-aliasing"
{{ ) else ( -}}
ENV PHP_CFLAGS="-fstack-protector-strong -fpic -fpie -O2 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -std=gnu99 -Wno-error=incompatible-pointer-types -fno-strict-aliasing"
{{ ) end -}}
ENV CXXFLAGS="-fstack-protector-strong -fpic -fpie -O2{{ if old_gcc then "" else " -std=c++17" end }}"
{{ if vid >= ("8" | version_id) then ( -}}
# PHP 8.0 as well (same flags in deb.sury.org php8.0); its ext/intl adds -std=c++11 after CXXFLAGS, ICU_CXXFLAGS comes last
ENV ICU_CXXFLAGS="-std=c++17"
{{ ) else "" end -}}
{{ ) else ( -}}
ENV PHP_CFLAGS="-fstack-protector-strong -fpic -fpie -O2 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64"
{{ ) end -}}
ENV PHP_CPPFLAGS="$PHP_CFLAGS"
ENV PHP_LDFLAGS="-Wl,-O1 -pie"

