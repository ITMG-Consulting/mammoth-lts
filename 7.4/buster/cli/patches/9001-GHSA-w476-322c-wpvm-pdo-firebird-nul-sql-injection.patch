Origin: https://github.com/php/php-src/commit/3f40b65323dd1b85e9bab6878237d3867e449d5c
Advisory: GHSA-w476-322c-wpvm, CVE-2025-14179
Imported-by: backported to 7.4 by hand (7.4 has no getToken()-based preprocess(): NUL-safe quoter on the char**/size_t* API + real SQL length passed to isc_dsql_prepare(); test without --EXTENSIONS--/--XLEAK-- for the 7.4 run-tests; built and tested on Debian bookworm/Firebird 3 and trixie/Firebird 4)

From 4925e5c62aeda59cb434524a2087d79bd33798ac Mon Sep 17 00:00:00 2001
From: Saki Takamachi <saki@sakiot.com>
Date: Sun, 3 May 2026 19:56:30 +0200
Subject: [PATCH] GHSA-w476-322c-wpvm: [pdo_firebird] Fix SQL injection via NUL
 bytes in quoted strings

Fixes GHSA-w476-322c-wpvm
Fixes CVE-2025-14179

Backport of php-src 3f40b65323dd1b85e9bab6878237d3867e449d5c (PHP-8.2) to PHP 7.4:
- 7.4 has no getToken()-based preprocess(): its byte-copying named-parameter loop in firebird_alloc_prepare_stmt() already keeps NUL bytes, so only the resulting length is computed and passed to isc_dsql_prepare() instead of 0 (NUL-terminated); the strncpy/strncat/p_peek hunks of preprocess() do not apply
- firebird_handle_quoter(): same NUL-safe counting/copying loops, on the 7.4 char **quoted/size_t *quotedlen API
- test: --EXTENSIONS-- dropped (7.4 run-tests compares it case-sensitively with "PDO_Firebird" and tries to load a shared pdo_firebird.so) and --XLEAK-- dropped (7.4 run-tests reports any test carrying it as XLEAK instead of PASS/FAIL)
---
 ext/pdo_firebird/firebird_driver.c            | 29 +++++++++-----
 .../tests/ghsa-w476-322c-wpvm.phpt            | 39 +++++++++++++++++++
 2 files changed, 58 insertions(+), 10 deletions(-)
 create mode 100644 ext/pdo_firebird/tests/ghsa-w476-322c-wpvm.phpt

diff --git a/ext/pdo_firebird/firebird_driver.c b/ext/pdo_firebird/firebird_driver.c
index 5b74290a..70628e07 100644
--- a/ext/pdo_firebird/firebird_driver.c
+++ b/ext/pdo_firebird/firebird_driver.c
@@ -244,8 +244,9 @@ static int firebird_handle_quoter(pdo_dbh_t *dbh, const char *unquoted, size_t u
 	char **quoted, size_t *quotedlen, enum pdo_param_type paramtype)
 {
 	size_t qcount = 0;
-	char const *co, *l, *r;
+	char const *co, *l;
 	char *c;
+	const char *end;
 
 	if (!unquotedlen) {
 		*quotedlen = 2;
@@ -254,9 +255,15 @@ static int firebird_handle_quoter(pdo_dbh_t *dbh, const char *unquoted, size_t u
 		return 1;
 	}
 
+	end = unquoted + unquotedlen;
+
 	/* Firebird only requires single quotes to be doubled if string lengths are used */
 	/* count the number of ' characters */
-	for (co = unquoted; (co = strchr(co,'\'')); qcount++, co++);
+	for (co = unquoted; co < end; co++) {
+		if (*co == '\'') {
+			qcount++;
+		}
+	}
 
 	if (UNEXPECTED(unquotedlen + 2 > ZSTR_MAX_LEN - qcount)) {
 		return 0;
@@ -267,15 +274,14 @@ static int firebird_handle_quoter(pdo_dbh_t *dbh, const char *unquoted, size_t u
 	*c++ = '\'';
 
 	/* foreach (chunk that ends in a quote) */
-	for (l = unquoted; (r = strchr(l,'\'')); l = r+1) {
-		strncpy(c, l, r-l+1);
-		c += (r-l+1);
-		/* add the second quote */
-		*c++ = '\'';
+	for (l = unquoted; l < end; l++) {
+		*c++ = *l;
+		if (*l == '\'') {
+			/* add the second quote */
+			*c++ = '\'';
+		}
 	}
 
-	/* copy the remainder */
-	strncpy(c, l, *quotedlen-(c-*quoted)-1);
 	(*quoted)[*quotedlen-1] = '\'';
 	(*quoted)[*quotedlen]   = '\0';
 
@@ -369,6 +375,7 @@ static int firebird_alloc_prepare_stmt(pdo_dbh_t *dbh, const char *sql, size_t s
 	pdo_firebird_db_handle *H = (pdo_firebird_db_handle *)dbh->driver_data;
 	char *c, *new_sql, in_quote, in_param, pname[64], *ppname;
 	zend_long l, pindex = -1;
+	size_t new_sql_len;
 
 	/* Firebird allows SQL statements up to 64k, so bail if it doesn't fit */
 	if (sql_len > 65536) {
@@ -428,9 +435,11 @@ static int firebird_alloc_prepare_stmt(pdo_dbh_t *dbh, const char *sql, size_t s
 		}
 		*c++ = sql[l];
 	}
+	/* the loop above also copied the terminating NUL byte of sql */
+	new_sql_len = c - new_sql - 1;
 
 	/* prepare the statement */
-	if (isc_dsql_prepare(H->isc_status, &H->tr, s, 0, new_sql, H->sql_dialect, out_sqlda)) {
+	if (isc_dsql_prepare(H->isc_status, &H->tr, s, new_sql_len, new_sql, H->sql_dialect, out_sqlda)) {
 		RECORD_ERROR(dbh);
 		efree(new_sql);
 		return 0;
diff --git a/ext/pdo_firebird/tests/ghsa-w476-322c-wpvm.phpt b/ext/pdo_firebird/tests/ghsa-w476-322c-wpvm.phpt
new file mode 100644
index 00000000..8dafc2e7
--- /dev/null
+++ b/ext/pdo_firebird/tests/ghsa-w476-322c-wpvm.phpt
@@ -0,0 +1,39 @@
+--TEST--
+GHSA-w476-322c-wpvm: SQL injection in pdo_firebird via NUL bytes in quoted strings
+--SKIPIF--
+<?php require('skipif.inc'); ?>
+--FILE--
+<?php
+
+require("testdb.inc");
+
+$dbh->exec('CREATE TABLE ghsa_w476_322c_wpvm (name VARCHAR(255))');
+
+$param = $dbh->quote("\0");
+$param2 = $dbh->quote('or 1=1--');
+var_export($param);
+echo("\n");
+
+echo "prepare: ";
+$stmt = $dbh->prepare("SELECT * FROM ghsa_w476_322c_wpvm WHERE name = {$param} AND name = {$param2}");
+$stmt->execute();
+echo json_encode($stmt->fetchAll(PDO::FETCH_ASSOC)) . "\n";
+
+echo "query:   ";
+$stmt = $dbh->query("SELECT * FROM ghsa_w476_322c_wpvm WHERE name = {$param} AND name = {$param2}");
+echo json_encode($stmt->fetchAll(PDO::FETCH_ASSOC)) . "\n";
+
+echo "exec:    ";
+$affectedRows = $dbh->exec("UPDATE ghsa_w476_322c_wpvm SET name = 'updated' WHERE name = {$param} AND name = {$param2}");
+echo $affectedRows . "\n";
+?>
+--CLEAN--
+<?php
+require 'testdb.inc';
+$dbh->exec("DROP TABLE ghsa_w476_322c_wpvm");
+?>
+--EXPECT--
+'\'' . "\0" . '\''
+prepare: []
+query:   []
+exec:    0
-- 
2.39.5

