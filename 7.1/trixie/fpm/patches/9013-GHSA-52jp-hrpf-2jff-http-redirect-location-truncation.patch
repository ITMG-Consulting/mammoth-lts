diff --git a/ext/standard/tests/http/http_empty_location_redirect.phpt b/ext/standard/tests/http/http_empty_location_redirect.phpt
new file mode 100644
index 0000000000000000000000000000000000000000..e24fb25bae28eb318f60f058be32fbbf5164b117
--- /dev/null
+++ b/ext/standard/tests/http/http_empty_location_redirect.phpt
@@ -0,0 +1,36 @@
+--TEST--
+Empty Location header must not over-read when building the redirect target
+--DESCRIPTION--
+GHSA-7875-c8px-7q5f: follow-up of the GHSA-52jp-hrpf-2jff fix (php-src GH-23467).
+--SKIPIF--
+<?php require 'server.inc'; http_server_skipif('tcp://127.0.0.1:22392'); ?>
+--INI--
+allow_url_fopen=1
+--FILE--
+<?php
+require 'server.inc';
+
+$responses = array(
+    "data://text/plain,HTTP/1.0 302 Found\r\nLocation:\r\nContent-Length: 0\r\n\r\n",
+    "data://text/plain,HTTP/1.0 302 Found\r\nLocation:\r\nContent-Length: 0\r\n\r\n",
+    "data://text/plain,HTTP/1.0 302 Found\r\nLocation:\r\nContent-Length: 0\r\n\r\n",
+    "data://text/plain,HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\nOK",
+);
+
+$pid = http_server("tcp://127.0.0.1:22392", $responses, $output);
+
+$ctx = stream_context_create(['http' => ['follow_location' => 1]]);
+echo @file_get_contents("http://127.0.0.1:22392/a/b", false, $ctx), "\n";
+
+http_server_kill($pid);
+
+fseek($output, 0, SEEK_SET);
+preg_match_all('/^GET (\S+) /m', stream_get_contents($output), $m);
+echo implode("\n", $m[1]), "\n";
+?>
+--EXPECT--
+OK
+/a/b
+/
+/
+/
diff --git a/ext/standard/tests/http/http_single_char_location_redirect.phpt b/ext/standard/tests/http/http_single_char_location_redirect.phpt
