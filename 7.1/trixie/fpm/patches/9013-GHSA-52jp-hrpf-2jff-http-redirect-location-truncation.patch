index 0000000000000000000000000000000000000000..b9979d55eaba712d1203269ca1f5db02765a5335
--- /dev/null
+++ b/ext/standard/tests/http/http_single_char_location_redirect.phpt
@@ -0,0 +1,33 @@
+--TEST--
+Single-char relative Location header keeps resolving against the host root (pre-GH-23467 behavior)
+--DESCRIPTION--
+Not RFC 3986 compliant ("x" against "/a/b" gives "/a/x"), but matches
+PHP's long-standing behavior of resolving against the host root. See GH-23521.
+--SKIPIF--
+<?php require 'server.inc'; http_server_skipif('tcp://127.0.0.1:22393'); ?>
+--INI--
+allow_url_fopen=1
+--FILE--
+<?php
+require 'server.inc';
+
+$responses = array(
+    "data://text/plain,HTTP/1.0 302 Found\r\nLocation: x\r\nContent-Length: 0\r\n\r\n",
+    "data://text/plain,HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\nOK",
+);
+
+$pid = http_server("tcp://127.0.0.1:22393", $responses, $output);
+
+$ctx = stream_context_create(['http' => ['follow_location' => 1]]);
+echo @file_get_contents("http://127.0.0.1:22393/a/b", false, $ctx), "\n";
+
+http_server_kill($pid);
+
+fseek($output, 0, SEEK_SET);
+preg_match_all('/^GET (\S+) /m', stream_get_contents($output), $m);
+echo implode("\n", $m[1]), "\n";
+?>
+--EXPECT--
+OK
+/a/b
+/x
