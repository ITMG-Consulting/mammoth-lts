From 0fc5dbf99905c78162390921c6abcc30836db841 Mon Sep 17 00:00:00 2001
From: Jakub Zelenka <bukka@php.net>
Date: Thu, 22 Oct 2026 08:59:59 +0000
Subject: [PATCH] Fix GHSA-hgf5-96fm-v528: http user header check of crlf

Backport of php-src 41d49abbd99dab06cdae4834db664435f8177174 (PHP-8.1) to PHP 7.2:
- 7.2 has no check_has_header(): it is introduced (from php-src cc704f5bb6, scanning all occurrences as since the fix for bug #79265) with the fixed CRLF condition, replacing the seven inline checks that accepted any CR, LF, tab or space before the header name
- tests ported to the 7.2 server.inc (request captured through the server output stream instead of ServerClientTestCase, HTTP/1.0 request line)
---
 ext/standard/http_fopen_wrapper.c             | 55 +++++++++---------
 .../tests/http/ghsa-hgf5-96fm-v528-001.phpt   | 56 +++++++++++++++++++
 .../tests/http/ghsa-hgf5-96fm-v528-002.phpt   | 53 ++++++++++++++++++
 .../tests/http/ghsa-hgf5-96fm-v528-003.phpt   | 55 ++++++++++++++++++
 4 files changed, 190 insertions(+), 29 deletions(-)
 create mode 100644 ext/standard/tests/http/ghsa-hgf5-96fm-v528-001.phpt
 create mode 100644 ext/standard/tests/http/ghsa-hgf5-96fm-v528-002.phpt
 create mode 100644 ext/standard/tests/http/ghsa-hgf5-96fm-v528-003.phpt

diff --git a/ext/standard/http_fopen_wrapper.c b/ext/standard/http_fopen_wrapper.c
index 4f336698..255d52a3 100644
--- a/ext/standard/http_fopen_wrapper.c
+++ b/ext/standard/http_fopen_wrapper.c
@@ -107,6 +107,17 @@ static inline void strip_header(char *header_bag, char *lc_header_bag,
 	}
 }
 
+static zend_bool check_has_header(const char *headers, const char *header) {
+	const char *s = headers;
+	while ((s = strstr(s, header))) {
+		if (s == headers || (*(s-1) == '\n' && *(s-2) == '\r')) {
+			return 1;
+		}
+		s++;
+	}
+	return 0;
+}
+
 typedef struct _php_stream_http_response_header_info {
 	php_stream_filter *transfer_encoding;
 	size_t file_size;
@@ -657,40 +668,26 @@ finish:
 				strip_header(user_headers, t, "content-type:");
 			}
 
-			if ((s = strstr(t, "user-agent:")) &&
-			    (s == t || *(s-1) == '\r' || *(s-1) == '\n' ||
-			                 *(s-1) == '\t' || *(s-1) == ' ')) {
-				 have_header |= HTTP_HEADER_USER_AGENT;
+			if (check_has_header(t, "user-agent:")) {
+				have_header |= HTTP_HEADER_USER_AGENT;
 			}
-			if ((s = strstr(t, "host:")) &&
-			    (s == t || *(s-1) == '\r' || *(s-1) == '\n' ||
-			                 *(s-1) == '\t' || *(s-1) == ' ')) {
-				 have_header |= HTTP_HEADER_HOST;
+			if (check_has_header(t, "host:")) {
+				have_header |= HTTP_HEADER_HOST;
 			}
-			if ((s = strstr(t, "from:")) &&
-			    (s == t || *(s-1) == '\r' || *(s-1) == '\n' ||
-			                 *(s-1) == '\t' || *(s-1) == ' ')) {
-				 have_header |= HTTP_HEADER_FROM;
-				}
-			if ((s = strstr(t, "authorization:")) &&
-			    (s == t || *(s-1) == '\r' || *(s-1) == '\n' ||
-			                 *(s-1) == '\t' || *(s-1) == ' ')) {
-				 have_header |= HTTP_HEADER_AUTH;
+			if (check_has_header(t, "from:")) {
+				have_header |= HTTP_HEADER_FROM;
 			}
-			if ((s = strstr(t, "content-length:")) &&
-			    (s == t || *(s-1) == '\r' || *(s-1) == '\n' ||
-			                 *(s-1) == '\t' || *(s-1) == ' ')) {
-				 have_header |= HTTP_HEADER_CONTENT_LENGTH;
+			if (check_has_header(t, "authorization:")) {
+				have_header |= HTTP_HEADER_AUTH;
 			}
-			if ((s = strstr(t, "content-type:")) &&
-			    (s == t || *(s-1) == '\r' || *(s-1) == '\n' ||
-			                 *(s-1) == '\t' || *(s-1) == ' ')) {
-				 have_header |= HTTP_HEADER_TYPE;
+			if (check_has_header(t, "content-length:")) {
+				have_header |= HTTP_HEADER_CONTENT_LENGTH;
 			}
-			if ((s = strstr(t, "connection:")) &&
-			    (s == t || *(s-1) == '\r' || *(s-1) == '\n' ||
-			                 *(s-1) == '\t' || *(s-1) == ' ')) {
-				 have_header |= HTTP_HEADER_CONNECTION;
+			if (check_has_header(t, "content-type:")) {
+				have_header |= HTTP_HEADER_TYPE;
+			}
+			if (check_has_header(t, "connection:")) {
+				have_header |= HTTP_HEADER_CONNECTION;
 			}
 			/* remove Proxy-Authorization header */
 			if (use_proxy && use_ssl && (s = strstr(t, "proxy-authorization:")) &&
diff --git a/ext/standard/tests/http/ghsa-hgf5-96fm-v528-001.phpt b/ext/standard/tests/http/ghsa-hgf5-96fm-v528-001.phpt
new file mode 100644
index 00000000..4566511c
--- /dev/null
+++ b/ext/standard/tests/http/ghsa-hgf5-96fm-v528-001.phpt
@@ -0,0 +1,56 @@
+--TEST--
+GHSA-hgf5-96fm-v528: Stream HTTP wrapper header check might omit basic auth header (incorrect inside pos)
+--SKIPIF--
+<?php require 'server.inc'; http_server_skipif('tcp://127.0.0.1:22385'); ?>
+--INI--
+allow_url_fopen=1
+--FILE--
+<?php
+require 'server.inc';
+
+$responses = array(
+    "data://text/plain,HTTP/1.0 200 Ok\r\nContent-Type: text/html; charset=utf-8\r\n\r\nbody",
+);
+
+$pid = http_server("tcp://127.0.0.1:22385", $responses, $output);
+
+$opts = [
+    "http" => [
+        "method" => "GET",
+        "header" => "Cookie: foo=bar\nauthorization:x\r\n"
+    ]
+];
+$ctx = stream_context_create($opts);
+var_dump(file_get_contents("http://user:pwd@127.0.0.1:22385", false, $ctx));
+var_dump($http_response_header);
+
+http_server_kill($pid);
+
+fseek($output, 0, SEEK_SET);
+var_dump(explode("\r\n", stream_get_contents($output)));
+?>
+--EXPECTF--
+string(4) "body"
+array(2) {
+  [0]=>
+  string(15) "HTTP/1.0 200 Ok"
+  [1]=>
+  string(38) "Content-Type: text/html; charset=utf-8"
+}
+array(7) {
+  [0]=>
+  string(14) "GET / HTTP/1.0"
+  [1]=>
+  string(33) "Authorization: Basic dXNlcjpwd2Q="
+  [2]=>
+  string(21) "Host: 127.0.0.1:%d"
+  [3]=>
+  string(17) "Connection: close"
+  [4]=>
+  string(31) "Cookie: foo=bar
+authorization:x"
+  [5]=>
+  string(0) ""
+  [6]=>
+  string(0) ""
+}
